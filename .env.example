# TubeFlow 환경변수 예시
# 이 파일을 복사해서 .env 로 저장 후 값을 채워주세요.
#   cp .env.example .env
# .env 파일은 절대 git에 커밋하지 마세요.

# -- 앱 설정 -----------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8421
LOG_LEVEL=INFO

# -- 소재 수집 API ------------------------------------------
# [1] The Guardian API (여행 뉴스 - 5,000건/일 무료)
# 발급: https://bonobo.capi.gutools.co.uk/register/developer
GUARDIAN_API_KEY=your_guardian_api_key_here

# [2] NewsAPI (전세계 여행 뉴스 - 100건/일 무료)
# 발급: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# [3] RSS 피드 - 키 불필요 (Lonely Planet, NatGeo, BBC Travel 등)
# [4] YouTube Trends - 아래 YOUTUBE_API_KEY 사용

# -- OpenAI API (대본 작성) ---------------------------------
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o

# -- YouTube Data API ---------------------------------------
# 발급: https://console.cloud.google.com
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_API_KEY=your_api_key_here

# -- 데이터베이스 -------------------------------------------
DATABASE_URL=sqlite:///./tubeflow.db

# -- 팀 서버 (선택) -----------------------------------------
TEAM_SERVER_URL=
TEAM_API_KEY=
